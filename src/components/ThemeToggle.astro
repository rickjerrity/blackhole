---
import { Sun, Moon } from 'lucide-astro';
---

<button id="theme-toggle" class="inline-flex ml-4 -mt-1 cursor-pointer">
  <Sun id="sun-icon" />
  <Moon id="moon-icon" />
</button>

<script>
  const THEME_KEY = 'theme';

  enum ThemeMode {
    DARK = 'DARK',
    LIGHT = 'LIGHT',
  }

  const themeMode = localStorage.getItem(THEME_KEY) as ThemeMode;

  function updateThemeIcon(themeMode: ThemeMode) {
    const sunIcon = document.getElementById('sun-icon') as HTMLElement;
    const moonIcon = document.getElementById('moon-icon') as HTMLElement;

    if (themeMode === ThemeMode.DARK) {
      sunIcon.style.display = 'block';
      moonIcon.style.display = 'none';
    } else {
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'block';
    }

    if (themeMode === ThemeMode.DARK) {
      const element = document.documentElement;
      element.classList.add('dark');
    }
  }

  function toggleThemeMode() {
    const themeMode = localStorage.getItem(THEME_KEY) as ThemeMode;

    const newThemeMode =
      themeMode === ThemeMode.DARK ? ThemeMode.LIGHT : ThemeMode.DARK;

    const element = document.documentElement;
    element.classList.toggle('dark');

    localStorage.setItem(THEME_KEY, newThemeMode);
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    toggleThemeMode();
    updateThemeIcon(
      (localStorage.getItem(THEME_KEY) as ThemeMode) || ThemeMode.LIGHT,
    );
  });

  updateThemeIcon(themeMode || ThemeMode.LIGHT);
</script>
